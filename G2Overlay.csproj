<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>G2Overlay</AssemblyName>
    <RootNamespace>G2Overlay</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Baixo consumo de memória / CPU -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pastas de teste/dump não fazem parte da compilação -->
    <Compile Remove="Claude_Test/**" />
    <Compile Remove="bin/**;obj/**" />
    <None Remove="Claude_Test/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- config.json só é copiado se ainda não existir na saída: o build não apaga as preferências do usuário. -->
    <None Update="Config\config.json" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('$(OutDir)Config\config.json')" />
    <None Update="Config\offsets.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Config\signatures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
